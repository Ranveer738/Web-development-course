import sys
import speech_recognition as sr
from deep_translator import MyMemoryTranslator
import pyttsx3

# Initialize Text-To-Speech engine safely across all OS platforms
def speak(text, language_code="hi"):
    try:
        engine = pyttsx3.init()
        engine.setProperty('rate', 140)  # Moderate speaking speed
        
        voices = engine.getProperty('voices')
        selected_voice = None

        # Attempt to find a native system voice matching the target language
        for voice in voices:
            if language_code in voice.id.lower() or language_code in voice.name.lower():
                selected_voice = voice.id
                break
        
        # Fallback to default system voice if specific language voice is missing
        if selected_voice:
            engine.setProperty('voice', selected_voice)
        elif len(voices) > 0:
            engine.setProperty('voice', voices[0].id)

        engine.say(text)
        engine.runAndWait()
        engine.stop()
    except Exception as e:
        print(f"⚠️ Audio output warning: {e}")

# Speech-to-Text: Capture voice input from default laptop microphone
def speech_to_text():
    recognizer = sr.Recognizer()
    
    try:
        with sr.Microphone() as source:
            print("\n🎤 Adjusting for background noise... Please wait.")
            recognizer.adjust_for_ambient_noise(source, duration=1)
            print("🎤 Listening... Speak clearly in English now!")
            audio = recognizer.listen(source, timeout=8, phrase_time_limit=10)

        print("🔍 Processing speech...")
        text = recognizer.recognize_google(audio, language="en-US")
        print(f"✅ You said: {text}")
        return text

    except sr.WaitTimeoutError:
        print("❌ Listening timed out. No speech detected.")
    except sr.UnknownValueError:
        print("❌ Could not understand the audio.")
    except sr.RequestError as e:
        print(f"❌ Speech API Network Error: {e}")
    except Exception as e:
        print(f"❌ Microphone/Audio Error: {e}")
    
    return ""

# Translate text reliably without hitting rate limits
def translate_text(text, target_language="hi"):
    try:
        # MyMemory supports standard 2-letter ISO codes
        translator = MyMemoryTranslator(source='en', target=target_language)
        translation = translator.translate(text)
        print(f"🌍 Translation ({target_language}): {translation}")
        return translation
    except Exception as e:
        print(f"❌ Translation Error: {e}")
        return ""

# Display available target languages
def display_language_options():
    print("\n" + "=" * 40)
    print("🌍 SELECT TARGET TRANSLATION LANGUAGE")
    print("=" * 40)
    print("1. Hindi (hi)")
    print("2. Tamil (ta)")
    print("3. Telugu (te)")
    print("4. Bengali (bn)")
    print("5. Marathi (mr)")
    print("6. Gujarati (gu)")
    print("7. Malayalam (ml)")
    print("8. Punjabi (pa)")
    print("9. Spanish (es)")
    print("10. French (fr-FR)")

    choice = input("\nEnter number (1-10) [Default: 1 - Hindi]: ").strip()
    
    language_dict = {
        "1": "hi",
        "2": "ta",
        "3": "te",
        "4": "bn",
        "5": "mr",
        "6": "gu",
        "7": "ml",
        "8": "pa",
        "9": "es",
        "10": "fr-FR"
    }
    
    return language_dict.get(choice, "hi")

# Main Execution Loop
def main():
    target_language = display_language_options()
    original_text = speech_to_text()
    
    if original_text:
        translated_text = translate_text(original_text, target_language=target_language)
        if translated_text:
            print("\n🔊 Speaking translation out...")
            speak(translated_text, language_code=target_language)
            print("✅ Complete!")

if __name__ == "__main__":
    main()
